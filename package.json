{
  "name": "robinhood-trading-agents",
  "productName": "Robinhood Trading Agents",
  "version": "0.1.0",
  "description": "A local-first desktop app where every trading agent is a message thread. Give an agent one job in plain English; it runs on a schedule on your computer, thinks with your own Claude, ChatGPT, OpenRouter or local model, and trades only through your own Robinhood account (paper by default).",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "preview": "vite --config vite.preview.config.ts",
    "check": "tsx scripts/run-checks.ts",
    "gen:brand-marks": "tsx scripts/gen-brand-marks.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.193",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@elyxndra/agent": "^0.1.0",
    "@elyxndra/engine": "^0.1.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@modelcontextprotocol/client": "^2.0.0",
    "@openrouter/agent": "^0.11.0",
    "@openrouter/sdk": "^1.2.54",
    "react-markdown": "^9.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "clsx": "^2.1.1",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.21.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "zustand": "^5.0.14"
  }
}
